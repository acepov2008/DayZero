# Filled by the builder at build time (winget packages, Office Deployment Tool, ...)
kit/bundled/

# Runtime output
kit/Logs/*
!kit/Logs/.gitkeep
kit/config/settings.json
kit/state.json*
kit/backup/
kit/build-*.marker

# Test / editor output
TestResults/
*.log
.vscode/
kit/language.txt

# Python bytecode from running the Linux kit tests
__pycache__/
*.pyc
