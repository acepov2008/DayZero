<?xml version="1.0" encoding="utf-8"?>
<!-- Shows the generated autounattend.xml (passwords masked). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DayZero - answer file preview"
        Width="900" Height="700" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DzWindowBackground}"
        Foreground="{StaticResource DzText}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource DzHint}" Margin="0,0,0,10"
                   Text="This is what Windows Setup will read. Password values are hidden here, but on the USB stick they are only base64-encoded. Notice there is no disk configuration: you will pick the disk yourself."/>
        <TextBox x:Name="PreviewText" Grid.Row="1" Style="{StaticResource DzLogBox}" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" Foreground="{StaticResource DzText}"/>
        <Button x:Name="ClosePreviewButton" Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0" Content="_Close"/>
    </Grid>
</Window>
