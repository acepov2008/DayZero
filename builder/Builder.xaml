<?xml version="1.0" encoding="utf-8"?>
<!-- DayZero USB Builder window. Styles come from kit\ui\Theme.xaml. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="BuilderWindow"
        Title="DayZero USB Builder"
        Width="1080" Height="860" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DzWindowBackground}"
        Foreground="{StaticResource DzText}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <ContentControl Grid.Row="0" Template="{StaticResource DzHeaderArt}"/>
        <Grid Grid.Row="0" Margin="24,18,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DAYZERO" Style="{StaticResource DzTitle}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF2BD6" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                    </TextBlock.Effect>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                     From="12" To="30" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock x:Name="VersionText" Text="USB BUILDER" Style="{StaticResource DzSubtitle}" Margin="2,0,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource DzHint}" Margin="0,0,290,0"
                       Text="Adds an answer file + the DayZero toolkit to a Windows USB&#x0a;made with the Media Creation Tool or Rufus."/>
        </Grid>
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="2" Margin="24,0" Background="{StaticResource DzNeonGradient}"
                Effect="{StaticResource DzGlowMagenta}"/>

        <!-- ===== Body ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource DzCard}">
                        <StackPanel>
                            <TextBlock Text="&#x2460;  WHERE TO WRITE" Style="{StaticResource DzCardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TargetUsbRadio" GroupName="Target" IsChecked="True" Content="Windows install _USB stick"/>
                                <RadioButton x:Name="TargetFolderRadio" GroupName="Target" Content="_Folder (to test in a virtual machine)"/>
                            </StackPanel>
                            <Grid x:Name="UsbPanel" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="DriveCombo" DisplayMemberPath="Display"/>
                                <Button x:Name="RefreshDrivesButton" Grid.Column="1" Margin="8,0,0,0" Content="_Refresh" ToolTip="Look for USB sticks again"/>
                            </Grid>
                            <Grid x:Name="FolderPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderText"/>
                                <Button x:Name="BrowseFolderButton" Grid.Column="1" Margin="8,0,0,0" Content="_Browse..."/>
                            </Grid>
                            <TextBlock x:Name="MediaInfoText" Style="{StaticResource DzHint}" Text="Looking for Windows installation USB sticks..."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DzCard}">
                        <StackPanel>
                            <TextBlock Text="&#x2461;  WINDOWS" Style="{StaticResource DzCardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Win11Radio" GroupName="WinVer" IsChecked="True" Content="Windows 11"/>
                                <RadioButton x:Name="Win10Radio" GroupName="WinVer" Content="Windows 10"/>
                            </StackPanel>
                            <TextBlock Text="Edition" Style="{StaticResource DzLabel}"/>
                            <ComboBox x:Name="EditionCombo" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                            <TextBox x:Name="ProductKeyText" Margin="0,8,0,0" Visibility="Collapsed" MaxLength="29"
                                     ToolTip="Your own product key: XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"/>
                            <TextBlock x:Name="EditionHintText" Style="{StaticResource DzHint}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DzCard}">
                        <StackPanel>
                            <TextBlock Text="&#x2462;  YOUR ACCOUNT" Style="{StaticResource DzCardTitle}"/>
                            <TextBlock Text="User name (a local account, no Microsoft account needed)" Style="{StaticResource DzLabel}"/>
                            <TextBox x:Name="UserNameText" MaxLength="20"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Password" Style="{StaticResource DzLabel}"/>
                                    <PasswordBox x:Name="PasswordBox1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Confirm password" Style="{StaticResource DzLabel}"/>
                                    <PasswordBox x:Name="PasswordBox2"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="GeneratePasswordButton" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Content="_Generate a temporary password"/>
                            <TextBlock x:Name="GeneratedPasswordText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{StaticResource DzCyan}" FontWeight="SemiBold"/>
                            <CheckBox x:Name="TempPasswordCheck">
                                <TextBlock TextWrapping="Wrap" Text="Temporary password: Windows asks for a new one at the first sign-in after DayZero finishes"/>
                            </CheckBox>
                            <CheckBox x:Name="AutoLogonCheck" IsChecked="True">
                                <TextBlock TextWrapping="Wrap" Text="Sign in automatically until DayZero finishes, so it can continue after restarts (recommended)"/>
                            </CheckBox>
                            <Border Style="{StaticResource DzWarningBox}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="&#x26A0; Heads-up:" FontWeight="Bold" Foreground="{StaticResource DzRed}"/>
                                    <Run Text="Windows stores this password in autounattend.xml as base64. That is encoding, not encryption: anyone with this USB stick can read it. Use a temporary password, or delete autounattend.xml from the stick after installing."/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource DzCard}">
                        <StackPanel>
                            <TextBlock Text="&#x2463;  THIS PC" Style="{StaticResource DzCardTitle}"/>
                            <TextBlock Text="Computer name" Style="{StaticResource DzLabel}"/>
                            <TextBox x:Name="ComputerNameText" MaxLength="15"/>
                            <TextBlock Style="{StaticResource DzHint}" Text="Up to 15 letters, digits or hyphens. Leave empty and Windows picks a random name."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DzCard}">
                        <StackPanel>
                            <TextBlock Text="&#x2464;  LANGUAGE &amp; REGION" Style="{StaticResource DzCardTitle}"/>
                            <TextBlock Text="Windows display language" Style="{StaticResource DzLabel}"/>
                            <ComboBox x:Name="DisplayLanguageCombo" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                            <TextBlock Text="Region format (dates, numbers, currency)" Style="{StaticResource DzLabel}"/>
                            <ComboBox x:Name="RegionCombo" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                            <TextBlock Text="Keyboard layout" Style="{StaticResource DzLabel}"/>
                            <ComboBox x:Name="KeyboardCombo" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                            <TextBlock Text="Time zone" Style="{StaticResource DzLabel}"/>
                            <ComboBox x:Name="TimeZoneCombo" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                            <Button x:Name="UseThisPcButton" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Use _this PC's settings"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DzCard}">
                        <StackPanel>
                            <TextBlock Text="&#x2465;  DEFAULT MODE" Style="{StaticResource DzCardTitle}"/>
                            <UniformGrid x:Name="ModeCardsPanel" Columns="2"/>
                            <Border Style="{StaticResource DzInfoBox}">
                                <StackPanel>
                                    <TextBlock x:Name="ModeIncludesTitle" FontWeight="Bold" Foreground="{StaticResource DzCyan}" Text="WHAT THIS MODE INCLUDES"/>
                                    <TextBlock x:Name="ModeIncludesText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" LineHeight="18"/>
                                    <Button x:Name="CustomizeButton" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"
                                            Content="_Choose apps and options..."/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource DzHint}" Text="This is only pre-selected: you can still pick another mode on the new PC."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DzCard}">
                        <StackPanel>
                            <TextBlock Text="&#x2466;  CLEAN-UP LEVEL" Style="{StaticResource DzCardTitle}"/>
                            <TextBlock Style="{StaticResource DzHint}" Margin="0,0,0,6"
                                       Text="How much of Windows' preinstalled extras and data collection to remove, for any mode. Modelled on Chris Titus Tech's WinUtil presets."/>
                            <UniformGrid x:Name="LevelCardsPanel" Columns="2"/>
                            <Border Style="{StaticResource DzInfoBox}">
                                <StackPanel>
                                    <TextBlock x:Name="LevelIncludesTitle" FontWeight="Bold" Foreground="{StaticResource DzCyan}" Text="WHAT THIS LEVEL DOES"/>
                                    <TextBlock x:Name="LevelIncludesText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource DzHint}" Text="Pre-selected on the new PC, where every switch can still be changed. Everything is undone by DayZero.cmd -Undo."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DzCard}">
                        <StackPanel>
                            <TextBlock Text="&#x2467;  OPTIONS" Style="{StaticResource DzCardTitle}"/>
                            <CheckBox x:Name="DryRunCheck">
                                <TextBlock TextWrapping="Wrap" Text="Dry run: the wizard on the new PC only logs what it would do and changes nothing (for testing)"/>
                            </CheckBox>
                            <CheckBox x:Name="BundlesCheck" IsChecked="True">
                                <TextBlock TextWrapping="Wrap" Text="Put offline installers on the stick: winget (App Installer) and Microsoft's Office Deployment Tool, about 250 MB. Helps when the Store on a fresh PC is not ready yet."/>
                            </CheckBox>
                            <TextBlock Text="Microsoft 365 plan (Office and Everything modes)" Style="{StaticResource DzLabel}"/>
                            <ComboBox x:Name="OfficePlanCombo" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                            <Button x:Name="CheckAppsButton" HorizontalAlignment="Left" Margin="0,12,0,0" Content="_Check the app list with winget"
                                    ToolTip="Runs 'winget show' for every app id on this PC. Read-only."/>
                            <Border Style="{StaticResource DzInfoBox}">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DzText}"
                                           Text="Safety: DayZero never picks, wipes or partitions a disk. Windows Setup will stop and ask you which disk to install on."/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="2" Background="{StaticResource DzPanelSolid}" BorderBrush="{StaticResource DzBorder}" BorderThickness="0,1,0,0">
            <StackPanel Margin="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource DzMuted}" Text="Ready."/>
                    <Button x:Name="PreviewButton" Grid.Column="1" Margin="12,0,0,0" Content="_Preview answer file"/>
                    <Button x:Name="WriteButton" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource DzPrimaryButton}" Content="_WRITE TO USB  &#x25B6;"/>
                </Grid>
                <Expander x:Name="LogExpander" Header="Log" Foreground="{StaticResource DzMuted}" Margin="0,8,0,0">
                    <TextBox x:Name="LogText" Style="{StaticResource DzLogBox}" Height="130" Margin="0,6,0,0"/>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</Window>
