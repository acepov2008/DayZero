<?xml version="1.0" encoding="utf-8"?>
<!-- Custom mode: pick apps, Microsoft 365, clean-up level and tweaks in the builder.
     The picks are stored in settings.json and arrive pre-ticked on the new PC. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DayZero - choose apps and options"
        Width="1080" Height="820" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DzWindowBackground}"
        Foreground="{StaticResource DzText}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CUSTOM MODE" FontSize="22" FontWeight="Black" Foreground="{StaticResource DzMagenta}"/>
            <TextBlock Style="{StaticResource DzHint}" FontSize="13"
                       Text="Tick what you want on the new PC. These picks arrive pre-ticked there, and you can still change them before DayZero starts."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <Border Style="{StaticResource DzCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="APPS" Style="{StaticResource DzCardTitle}"/>
                        <WrapPanel x:Name="PickerAppsPanel" Orientation="Horizontal"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DzCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="CLEAN-UP AND TWEAKS" Style="{StaticResource DzCardTitle}"/>
                        <StackPanel x:Name="PickerOptionsPanel"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PickerCountText" VerticalAlignment="Center" Foreground="{StaticResource DzMuted}"/>
            <Button x:Name="PickerNoneButton" Grid.Column="1" Margin="10,0,0,0" Content="_Untick all"/>
            <Button x:Name="PickerCancelButton" Grid.Column="2" Margin="10,0,0,0" Content="_Cancel"/>
            <Button x:Name="PickerOkButton" Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource DzPrimaryButton}" Content="_SAVE PICKS"/>
        </Grid>
    </Grid>
</Window>
