#Requires -Version 5.1
<#
    DayZero - Microsoft 365 Apps through Microsoft's Office Deployment Tool (ODT).

    New-DzOfficeConfigXml builds configuration.xml from config\office.json: the chosen
    product (Personal/Family, Business or Enterprise), only the apps you want (everything
    else is an ExcludeApp), current channel, 64-bit, language matching Windows. Office is
    activated later by signing in with your own Microsoft account; DayZero never touches
    Office licensing.
#>

Set-StrictMode -Version 2.0

function Get-DzOfficeProductId {
    <# Maps the builder's plan choice to an ODT product id. #>
    [CmdletBinding()]
    [OutputType([string])]
    param([Parameter(Mandatory = $true)][object]$OfficeConfig, [AllowNull()][AllowEmptyString()][string]$Plan)
    if (-not $Plan) { $Plan = [string](Get-DzProperty $OfficeConfig 'defaultPlan' 'personal') }
    $id = Get-DzProperty (Get-DzProperty $OfficeConfig 'plans' $null) $Plan $null
    if (-not $id) { throw "Unknown Microsoft 365 plan '$Plan' (see config\office.json 'plans')." }
    return [string]$id
}

function New-DzOfficeConfigXml {
    <# Returns the ODT configuration.xml text. #>
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory = $true)][object]$OfficeConfig,
        [Parameter(Mandatory = $true)][string]$ProductId
    )
    $wanted = @(Get-DzProperty $OfficeConfig 'apps' @())
    $all = @(Get-DzProperty $OfficeConfig 'allApps' @())
    foreach ($w in $wanted) { if ($all -notcontains $w) { throw "office.json lists app '$w', which is not in allApps." } }
    $excluded = @($all | Where-Object { $wanted -notcontains $_ })

    $settings = New-Object System.Xml.XmlWriterSettings
    $settings.Indent = $true
    $settings.OmitXmlDeclaration = $true
    $settings.Encoding = New-Object System.Text.UTF8Encoding($false)
    $sb = New-Object System.Text.StringBuilder
    $w = [System.Xml.XmlWriter]::Create($sb, $settings)
    try {
        $w.WriteComment(' Generated by DayZero from config\office.json. Activate by signing in to Office with your Microsoft account. ')
        $w.WriteStartElement('Configuration')
        $w.WriteStartElement('Add')
        $w.WriteAttributeString('OfficeClientEdition', [string](Get-DzProperty $OfficeConfig 'edition' '64'))
        $w.WriteAttributeString('Channel', [string](Get-DzProperty $OfficeConfig 'channel' 'Current'))
        $w.WriteStartElement('Product')
        $w.WriteAttributeString('ID', $ProductId)
        $w.WriteStartElement('Language')
        $w.WriteAttributeString('ID', [string](Get-DzProperty $OfficeConfig 'language' 'MatchOS'))
        $fallback = [string](Get-DzProperty $OfficeConfig 'fallbackLanguage' '')
        if ($fallback) { $w.WriteAttributeString('Fallback', $fallback) }
        $w.WriteEndElement()
        foreach ($x in $excluded) {
            $w.WriteStartElement('ExcludeApp')
            $w.WriteAttributeString('ID', $x)
            $w.WriteEndElement()
        }
        $w.WriteEndElement()   # Product
        $w.WriteEndElement()   # Add
        $w.WriteStartElement('Updates')
        $w.WriteAttributeString('Enabled', 'TRUE')
        $w.WriteEndElement()
        if ([bool](Get-DzProperty $OfficeConfig 'removeMsi' $false)) {
            $w.WriteStartElement('RemoveMSI')
            $w.WriteEndElement()
        }
        $w.WriteStartElement('Display')
        $w.WriteAttributeString('Level', 'None')
        $w.WriteAttributeString('AcceptEULA', 'TRUE')
        $w.WriteEndElement()
        $w.WriteStartElement('Property')
        $w.WriteAttributeString('Name', 'FORCEAPPSHUTDOWN')
        $w.WriteAttributeString('Value', 'TRUE')
        $w.WriteEndElement()
        $w.WriteEndElement()   # Configuration
    }
    finally { $w.Dispose() }
    return $sb.ToString()
}

function Test-DzOfficeInstalled {
    <# True when Click-to-Run already has this product. #>
    [CmdletBinding()]
    [OutputType([bool])]
    param([Parameter(Mandatory = $true)][string]$ProductId)
    $c2r = Get-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Office\ClickToRun\Configuration' -ErrorAction SilentlyContinue
    if ($null -eq $c2r -or -not $c2r.PSObject.Properties['ProductReleaseIds']) { return $false }
    return (@(([string]$c2r.ProductReleaseIds) -split ',') -contains $ProductId)
}

function Get-DzOdtSetup {
    <#
        Finds or fetches the ODT's setup.exe: the stick's bundled copy, then winget
        (Microsoft.OfficeDeploymentTool), then Microsoft's Office CDN. Every candidate must be
        signed by Microsoft. Returns the path, or $null.
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param([Parameter(Mandatory = $true)][hashtable]$Context, [Parameter(Mandatory = $true)][object]$OfficeConfig)
    $odt = Get-DzProperty $OfficeConfig 'odt' $null
    $check = {
        param([string]$Path)
        if (-not $Path -or -not (Test-Path -LiteralPath $Path)) { return $false }
        $problem = Test-DzFileSignature -Path $Path -Publisher 'Microsoft Corporation'
        if ($problem) { Write-DzLog -Level Warn -Message "Not using $Path : $problem"; return $false }
        return $true
    }

    $bundled = [System.IO.Path]::Combine($Context.KitRoot, 'bundled', 'odt', 'setup.exe')
    if (& $check $bundled) { Write-DzLog -Message 'Using the Office Deployment Tool from the USB stick.'; return $bundled }

    $installDir = [Environment]::ExpandEnvironmentVariables([string](Get-DzProperty $odt 'wingetInstallDir' '%ProgramW6432%\OfficeDeploymentTool'))
    $wingetSetup = Join-Path $installDir 'setup.exe'
    if (-not (Test-Path -LiteralPath $wingetSetup)) {
        $wid = [string](Get-DzProperty $odt 'wingetId' '')
        if ($wid -and ($Context.Flags['WingetPath'] -or (Find-DzWinget))) {
            $r = Install-DzWingetPackage -Context $Context -Id $wid -Name 'Office Deployment Tool'
            Write-DzLog -Message ("Office Deployment Tool via winget: {0} {1}" -f $r.Status, $r.Message)
        }
    }
    if (& $check $wingetSetup) { return $wingetSetup }

    $url = [string](Get-DzProperty $odt 'downloadUrl' '')
    if ($url) {
        try {
            $dl = Save-DzDownload -Url $url -Path (Join-Path ([System.IO.Path]::GetTempPath()) 'DayZero-odt\setup.exe')
            if (& $check $dl) { Write-DzLog -Message "Downloaded the Office Deployment Tool from $url"; return $dl }
        }
        catch { Write-DzLog -Level Warn -Message ('ODT download failed: ' + $_.Exception.Message) }
    }
    return $null
}

function Install-DzOffice {
    <# The 'office' step body. Returns a step result. #>
    [CmdletBinding()]
    param([Parameter(Mandatory = $true)][hashtable]$Context)
    $cfg = $Context.Config.office
    if ($null -eq $cfg) { return (New-DzStepResult -Status Skipped -Message 'config\office.json is missing.') }
    $plan = [string](Get-DzProperty $Context.Settings 'officePlan' '')
    $productId = Get-DzOfficeProductId -OfficeConfig $cfg -Plan $plan
    if (Test-DzOfficeInstalled -ProductId $productId) {
        return (New-DzStepResult -Status Done -Message "Microsoft 365 ($productId) is already installed.")
    }

    $xml = New-DzOfficeConfigXml -OfficeConfig $cfg -ProductId $productId
    $work = Join-Path ([System.IO.Path]::GetTempPath()) 'DayZero-office'
    if (-not (Test-Path -LiteralPath $work)) { [void](New-Item -ItemType Directory -Path $work -Force) }
    $xmlPath = Join-Path $work 'configuration.xml'
    [System.IO.File]::WriteAllText($xmlPath, $xml, (New-Object System.Text.UTF8Encoding($false)))
    try {
        $logs = Join-Path $Context.KitRoot 'Logs'
        if (-not (Test-Path -LiteralPath $logs)) { [void](New-Item -ItemType Directory -Path $logs -Force) }
        Copy-Item -LiteralPath $xmlPath -Destination (Join-Path $logs 'office-configuration.xml') -Force -ErrorAction Stop
    }
    catch { Write-Verbose 'Could not copy the config to Logs.' }
    Write-DzLog -Message "Microsoft 365 configuration ($productId):"
    foreach ($line in ($xml -split "`r?`n")) { if ($line.Trim()) { Write-DzLog -Message "  $line" } }

    if (Test-DzDryRun) {
        return (New-DzStepResult -Status Done -Message "[DRY-RUN] would install Microsoft 365 Apps ($productId) with the Office Deployment Tool.")
    }
    $setup = Get-DzOdtSetup -Context $Context -OfficeConfig $cfg
    if (-not $setup) { return (New-DzStepResult -Status Failed -Message 'Could not get a Microsoft-signed Office Deployment Tool (see the log).') }

    if ($Context.Progress) { & $Context.Progress 'Downloading and installing Microsoft 365 Apps. This takes 10-30 minutes.' }
    $timeout = 60 * [int](Get-DzProperty $cfg 'timeoutMinutes' 90)
    $r = Invoke-DzAction -Description "Run the Office Deployment Tool: setup.exe /configure $xmlPath" -Action {
        Invoke-DzProcess -FilePath $setup -Arguments @('/configure', $xmlPath) -TimeoutSec $timeout
    }
    foreach ($line in @($r.Output | Select-Object -Last 10)) { Write-DzLog -Message "  ODT: $line" }
    if ($r.TimedOut) { return (New-DzStepResult -Status Failed -Message "The Office Deployment Tool did not finish within $($timeout / 60) minutes.") }
    if ($r.ExitCode -ne 0) {
        return (New-DzStepResult -Status Failed -Message ("Office Deployment Tool exit code {0}. Its own log is in {1}." -f $r.ExitCode, $env:TEMP))
    }
    if (-not (Test-DzOfficeInstalled -ProductId $productId)) {
        return (New-DzStepResult -Status Warn -Message 'The installer reported success, but Office is not registered yet. Check Start > Word.')
    }
    return (New-DzStepResult -Status Done -Message 'Installed. Open Word and sign in with your Microsoft account to activate.')
}

Export-ModuleMember -Function @('Get-DzOfficeProductId', 'New-DzOfficeConfigXml', 'Test-DzOfficeInstalled', 'Get-DzOdtSetup', 'Install-DzOffice')
