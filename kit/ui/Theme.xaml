<?xml version="1.0" encoding="utf-8"?>
<!--
    DayZero neon synthwave theme. Shared by the USB builder and the setup wizard.
    Loaded once into Application.Resources by kit\lib\Ui.psm1, so every window can use
    {StaticResource ...} names from here. Colours live at the top; tweak them freely.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Palette ===================================================== -->
    <!-- Monochrome professional palette: charcoal, grays and white. The key names are kept
         from the first (neon) theme so code and other XAML did not have to change:
         "Magenta" = primary accent (white), "Cyan" = secondary (light gray), "Purple" = mid gray. -->
    <Color x:Key="DzColorBg">#0F0F11</Color>
    <Color x:Key="DzColorMagenta">#FFFFFF</Color>
    <Color x:Key="DzColorCyan">#C9C9CE</Color>
    <Color x:Key="DzColorPurple">#6B6B72</Color>

    <SolidColorBrush x:Key="DzBg" Color="#0F0F11"/>
    <SolidColorBrush x:Key="DzPanel" Color="#17171A"/>
    <SolidColorBrush x:Key="DzPanelSolid" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="DzInput" Color="#121215"/>
    <SolidColorBrush x:Key="DzBorder" Color="#2C2C31"/>
    <SolidColorBrush x:Key="DzHover" Color="#242428"/>
    <SolidColorBrush x:Key="DzSelectedCardBg" Color="#222226"/>
    <SolidColorBrush x:Key="DzText" Color="#EDEDEF"/>
    <SolidColorBrush x:Key="DzMuted" Color="#8E8E95"/>
    <SolidColorBrush x:Key="DzMagenta" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DzCyan" Color="#C9C9CE"/>
    <SolidColorBrush x:Key="DzPurple" Color="#6B6B72"/>
    <SolidColorBrush x:Key="DzYellow" Color="#D4B45A"/>
    <SolidColorBrush x:Key="DzRed" Color="#E0605A"/>
    <SolidColorBrush x:Key="DzGreen" Color="#7FBF8A"/>
    <SolidColorBrush x:Key="DzScrollThumb" Color="#3E3E44"/>
    <SolidColorBrush x:Key="DzWarningBg" Color="#1FE0605A"/>
    <SolidColorBrush x:Key="DzInfoBg" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="DzPrimaryText" Color="#0F0F11"/>
    <SolidColorBrush x:Key="DzPrimaryHover" Color="#D9D9DD"/>

    <LinearGradientBrush x:Key="DzWindowBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#111113" Offset="0"/>
        <GradientStop Color="#0C0C0E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DzNeonGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#9A9AA0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DzSunsetGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EDEDEF" Offset="0"/>
        <GradientStop Color="#6B6B72" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DzPrimaryButtonBg" Color="#EDEDEF"/>

    <!-- No neon glows: soft, low shadows for depth only. -->
    <DropShadowEffect x:Key="DzGlowMagenta" Color="#000000" BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.45"/>
    <DropShadowEffect x:Key="DzGlowCyan" Color="#000000" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.35"/>
    <DropShadowEffect x:Key="DzGlowSoft" Color="#000000" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.25"/>
    <DropShadowEffect x:Key="DzTitleGlow" Color="#000000" BlurRadius="0" ShadowDepth="0" Opacity="0"/>

    <FontFamily x:Key="DzMono">Consolas, Cascadia Mono, Courier New</FontFamily>
    <FontFamily x:Key="DzEmoji">Segoe UI Emoji, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="DzSymbol">Segoe UI Symbol, Segoe UI</FontFamily>
    <FontFamily x:Key="DzIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Text styles (keyed: implicit TextBlock styles leak into controls) ===== -->
    <Style x:Key="DzTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DzMagenta}"/>
    </Style>
    <Style x:Key="DzSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource DzMuted}"/>
    </Style>
    <Style x:Key="DzCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DzText}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="DzLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DzMuted}"/>
        <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>
    <Style x:Key="DzHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DzMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- ===== Containers ===================================================== -->
    <Style x:Key="DzCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DzPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DzBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="8"/>
    </Style>
    <Style x:Key="DzWarningBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DzWarningBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DzRed}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
    <Style x:Key="DzInfoBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DzInfoBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DzBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <!-- ===== Buttons ========================================================= -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DzText}"/>
        <Setter Property="Background" Value="{StaticResource DzPanelSolid}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DzBorder}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DzHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzPurple}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzMagenta}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DzBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Primary action: solid white with dark text (the one high-contrast element on screen). -->
    <Style x:Key="DzPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DzPrimaryButtonBg}"/>
        <Setter Property="Foreground" Value="{StaticResource DzPrimaryText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DzPrimaryButtonBg}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="22,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DzPrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzPurple}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DzCyan}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text inputs ===================================================== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource DzText}"/>
        <Setter Property="Background" Value="{StaticResource DzInput}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DzBorder}"/>
        <Setter Property="CaretBrush" Value="{StaticResource DzCyan}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource DzMagenta}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzPurple}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzCyan}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DzLogBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource DzMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Foreground" Value="{StaticResource DzCyan}"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource DzText}"/>
        <Setter Property="Background" Value="{StaticResource DzInput}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DzBorder}"/>
        <Setter Property="CaretBrush" Value="{StaticResource DzCyan}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource DzMagenta}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzPurple}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzCyan}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox (dark drop-down) ======================================== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource DzText}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DzHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DzCyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource DzText}"/>
        <Setter Property="Background" Value="{StaticResource DzInput}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DzBorder}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                              Data="M0,0 L5,5 L10,0" Stroke="{StaticResource DzCyan}" StrokeThickness="1.8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzPurple}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="10,0,32,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource DzPanelSolid}" BorderBrush="{StaticResource DzMagenta}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource DzCyan}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox / RadioButton ========================================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource DzText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="{StaticResource DzCyan}" Background="{StaticResource DzInput}"
                                VerticalAlignment="Top" Margin="0,1,8,0">
                            <Path x:Name="Mark" Data="M3.5,9 L7.5,13 L14.5,5" Stroke="{StaticResource DzBg}"
                                  StrokeThickness="2.4" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource DzCyan}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DzMagenta}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DzMagenta}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource DzText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,4,18,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,8,0">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource DzCyan}" StrokeThickness="1.5" Fill="{StaticResource DzInput}"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource DzMagenta}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DzMagenta}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DzMagenta}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Big selectable card (a RadioButton underneath, so arrows/Space work).
         Hover: lighter border. Selected: white border and a slightly lighter surface. -->
    <Style x:Key="DzModeCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource DzText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" Padding="14,16"
                            BorderBrush="{StaticResource DzBorder}" Background="{StaticResource DzInput}">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzPurple}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DzHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzMagenta}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DzSelectedCardBg}"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource DzGlowCyan}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DzCyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slim scroll bars ============================================ -->
    <Style x:Key="DzScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="4" Background="{StaticResource DzScrollThumb}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource DzScrollThumbStyle}" Margin="2"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource DzScrollThumbStyle}" Margin="2"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Thin progress bar with a faint moving sheen ======================= -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource DzBorder}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" ClipToBounds="True"
                                Background="{StaticResource DzMagenta}">
                            <Rectangle x:Name="Shine" Width="90" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#40000000" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="-90"/>
                                </Rectangle.RenderTransform>
                                <!-- Started by the Rectangle's own Loaded event: it only fires once the element exists. -->
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="-90" To="1400" Duration="0:0:2.4" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header background: a flat panel (the neon sun and grid of earlier versions are gone).
         Use with <ContentControl Template="{StaticResource DzHeaderArt}"/> behind a header. -->
    <ControlTemplate x:Key="DzHeaderArt" TargetType="ContentControl">
        <Border Background="{StaticResource DzBg}" IsHitTestVisible="False"/>
    </ControlTemplate>

    <!-- ===== ToolTip =========================================================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource DzPanelSolid}"/>
        <Setter Property="Foreground" Value="{StaticResource DzText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DzBorder}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
</ResourceDictionary>
